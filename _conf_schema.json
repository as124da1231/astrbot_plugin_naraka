{
  "query_match_count": {
    "type": "int",
    "description": "查询对局数",
    "hint": "目标查询场次，默认 30，不设插件上限。超过单页数量时尝试翻页；若小黑盒不提供后续页面，只显示实际取到的场次。",
    "default": 30
  },
  "selected_match_count": {
    "type": "int",
    "description": "有效对局选择数",
    "hint": "筛选目标模式后最多尝试查询几场详情，不设插件上限。详情失败不从更早的对局补位，实际有效场次可能更少。",
    "default": 10
  },
